# --- Stage 1: Build static assets ---
FROM node:20-alpine AS builder
WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .
# Run Vite build script to generate the 'dist' directory
RUN npm run build

# --- Stage 2: Serve assets via Nginx ---
FROM nginx:1.25-alpine AS runner

# Copy compiled production assets from stage 1 to Nginx default public directory
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]