{
  "name": "hostel-hub-root",
  "version": "1.0.0",
  "scripts": {
    "install:all": "npm install && cd backend && npm install && cd ../fronted && npm install",
    "backend": "cd backend && npm run dev",
    "frontend": "cd fronted && npm run dev",
    "start": "concurrently \"npm run backend\" \"npm run frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}